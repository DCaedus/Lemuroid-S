<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/settings"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_category_general"
        app:iconSpaceReserved="false">

        <SwitchPreference
            android:key="@string/pref_key_autosave"
            android:title="@string/settings_title_enable_autosave"
            android:summary="@string/settings_description_enable_autosave"
            app:iconSpaceReserved="false"
            android:defaultValue="true"/>

        <ListPreference
            android:key="@string/pref_key_periodic_autosave_minutes"
            android:title="@string/settings_title_periodic_autosave"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_periodic_autosave_display_names"
            app:entryValues="@array/pref_key_periodic_autosave_values"
            android:defaultValue="30"/>

        <PreferenceScreen
            android:key="@string/pref_key_open_core_settings"
            android:title="@string/settings_title_core_settings"
            android:summary="@string/settings_description_core_settings"
            app:iconSpaceReserved="false"/>

        <SwitchPreference
            android:key="@string/pref_key_enable_immersive_mode"
            android:title="@string/settings_title_immersive_mode"
            android:summary="@string/settings_description_immersive_mode"
            app:iconSpaceReserved="false"
            android:defaultValue="false"/>

        <SwitchPreference
            android:key="@string/pref_key_hd_mode"
            android:title="@string/settings_title_hd_mode"
            android:summary="@string/settings_description_hd_mode"
            app:iconSpaceReserved="false"
            app:disableDependentsState="true"
            android:defaultValue="true"/>

        <SeekBarPreference
            android:key="@string/pref_key_hd_mode_quality"
            android:title="@string/settings_title_hd_quality"
            android:summary="@string/settings_description_hd_quality"
            app:min="0"
            android:max="2"
            app:seekBarIncrement="1"
            app:showSeekBarValue="false"
            app:iconSpaceReserved="false"
            android:defaultValue="0"/>

        <ListPreference
            android:key="@string/pref_key_shader_filter"
            android:title="@string/display_filter"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_shader_filter_display_names"
            app:entryValues="@array/pref_key_shader_filter_values"
            app:dependency="@string/pref_key_hd_mode"
            android:defaultValue="auto"/>

        <SwitchPreference
            android:key="@string/pref_key_show_framerate"
            android:title="@string/settings_title_show_framerate"
            android:summary="@string/settings_description_show_framerate"
            app:iconSpaceReserved="false"
            android:defaultValue="false"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_artwork"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="@string/pref_key_artwork_type"
            android:title="@string/settings_title_artwork_type"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_artwork_type_display_names"
            app:entryValues="@array/pref_key_artwork_type_values"
            android:defaultValue="boxart"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_fast_forward"
        app:iconSpaceReserved="false">

        <ListPreference
            android:key="@string/pref_key_fast_forward_speed"
            android:title="@string/settings_title_fast_forward_speed"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_fast_forward_speed_display_names"
            app:entryValues="@array/pref_key_fast_forward_speed_values"
            android:defaultValue="4"/>

        <ListPreference
            android:key="@string/pref_key_fast_forward_audio"
            android:title="@string/settings_title_fast_forward_audio"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_fast_forward_audio_display_names"
            app:entryValues="@array/pref_key_fast_forward_audio_values"
            android:defaultValue="lower"/>

        <SeekBarPreference
            android:key="@string/pref_key_fast_forward_volume"
            android:title="@string/settings_title_fast_forward_volume"
            app:min="0"
            android:max="10"
            app:seekBarIncrement="1"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false"
            android:defaultValue="2"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_input"
        app:iconSpaceReserved="false">

        <PreferenceScreen
            android:key="@string/pref_key_open_gamepad_settings"
            android:summary="@string/settings_description_gamepad_settings"
            app:iconSpaceReserved="false"
            android:title="@string/settings_title_gamepad_settings"/>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_category_misc"
        app:iconSpaceReserved="false">

        <PreferenceScreen
            android:key="@string/pref_key_open_save_sync_settings"
            android:title="@string/settings_title_save_sync"
            app:summary="@string/settings_description_save_sync"
            app:iconSpaceReserved="false"/>

        <Preference
            android:key="@string/pref_key_tv_language"
            android:title="@string/settings_title_language"
            android:summary="@string/settings_description_language"
            app:iconSpaceReserved="false"/>

        <ListPreference
            android:key="update_check_frequency"
            android:title="@string/settings_title_update_frequency"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"
            android:entries="@array/pref_key_update_frequency_display_names"
            app:entryValues="@array/pref_key_update_frequency_values"
            android:defaultValue="weekly"/>

        <Preference
            android:key="@string/pref_key_tv_check_updates"
            android:title="@string/settings_title_check_updates"
            android:summary="@string/settings_description_check_updates"
            app:iconSpaceReserved="false"/>

        <PreferenceScreen
            android:key="@string/pref_key_display_bios_info"
            android:title="@string/settings_title_display_bios_info"
            app:summary="@string/settings_description_display_bios_info"
            app:iconSpaceReserved="false"/>

        <PreferenceScreen
            android:key="@string/pref_key_advanced_settings"
            android:title="@string/settings_title_advanced_settings"
            android:summary="@string/settings_description_advanced_settings"
            app:iconSpaceReserved="false">

            <PreferenceCategory
                android:title="@string/settings_category_input"
                app:iconSpaceReserved="false">

                <SwitchPreference
                    android:key="@string/pref_key_enable_rumble"
                    android:title="@string/settings_title_enable_rumble"
                    android:summary="@string/settings_description_enable_rumble"
                    app:iconSpaceReserved="false"
                    android:defaultValue="false"/>

            </PreferenceCategory>

            <PreferenceCategory
                android:title="@string/settings_category_general"
                app:iconSpaceReserved="false">

                <Preference
                    android:key="@string/pref_key_tv_first_launch_setup"
                    android:title="@string/settings_title_first_launch_setup"
                    android:summary="@string/settings_description_tv_first_launch_setup"
                    app:iconSpaceReserved="false"/>

                <SwitchPreference
                    android:key="@string/pref_key_low_latency_audio"
                    android:title="@string/settings_title_low_latency_audio"
                    android:summary="@string/settings_description_low_latency_audio"
                    app:iconSpaceReserved="false"
                    android:defaultValue="false"/>

                <Preference
                    android:key="@string/pref_key_reset_settings"
                    android:title="@string/settings_title_reset_settings"
                    app:summary="@string/settings_description_reset_settings"
                    app:iconSpaceReserved="false"/>

            </PreferenceCategory>

        </PreferenceScreen>

    </PreferenceCategory>

</PreferenceScreen>
