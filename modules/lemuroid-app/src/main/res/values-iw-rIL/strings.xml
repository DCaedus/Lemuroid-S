    <string name="main_folder_card_title">יצירת תיקיית Lemuroid-S</string>
    <string name="main_folder_card_message">תיקיית Lemuroid-S הראשית שומרת את קובצי ה-ROM שלך (אופציונלי), את השמירות ואת העטיפות.</string>
    <string name="main_folder_card_action">יצירת תיקייה</string>
    <string name="main_folder_dialog_message">בגלל מגבלות של מערכת הקבצים של Android, צריך ליצור את תיקיית Lemuroid-S הראשית באופן ידני.\n\nיש ליצור תיקייה בשם Lemuroid-S או לבחור היכן ליצור אותה, ואז להקיש על שימוש בתיקייה הזו.</string>
    <string name="main_folder_dialog_ok">אישור</string>
    <string name="main_folder_failed">לא ניתן להשתמש בתיקייה הזו. יש ליצור או לבחור תיקייה אחרת.</string>
    <string name="main_folder_required">יש לבחור קודם את תיקיית Lemuroid-S</string>
    <string name="main_folder_lost_title">אין גישה לתיקיית Lemuroid-S</string>
    <string name="main_folder_lost_message">השמירות, קובצי ה-ROM והעטיפות שלך נמצאים בתיקיית Lemuroid-S, אבל Android כבר לא מאפשר ל-Lemuroid-S לפתוח אותה. ייתכן שהיא הועברה, שונה שמה או נמחקה, או שהגישה הוסרה.\n\nיש לבחור שוב את תיקיית Lemuroid-S כדי להמשיך לשחק. בינתיים שום דבר לא הולך לאיבוד.</string>
